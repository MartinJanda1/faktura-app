{
  "version": 2,
  "builds": [
    {
      "src": "vercel-entry.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "app.js",
          "app-list.js",
          "css/**",
          "js/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/vercel-entry.js" }
  ]
}
