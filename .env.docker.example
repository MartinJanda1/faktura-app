# Zkopíruj jako .env vedle docker-compose.yml (volitelné — výchozí hodnoty jsou v compose)

APP_PORT=3000
PG_DATABASE=fakturaApp
PG_USER=cbos
PG_PASSWORD=cbos

# Pouze pro docker-compose.app-only.yml — název existujícího postgres kontejneru
# PG_HOST=postgres-1

# Migrace při startu kontejneru (true / false)
RUN_MIGRATIONS=true
